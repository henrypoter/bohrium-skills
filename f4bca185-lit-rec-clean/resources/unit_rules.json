{
 "version": "1.0",
 "description": "单位换算（U 系）。std = raw*factor + offset；prefixable=true 允许 SI 前缀分解；复合单位 a/b、a b-N 自动解析；ranges 为越界检查。扩充=加规则或别名。",
 "prefixes": {"n": 1e-09, "µ": 1e-06, "u": 1e-06, "m": 0.001, "c": 0.01, "d": 0.1, "h": 100.0, "k": 1000.0, "M": 1000000.0, "G": 1000000000.0, "T": 1000000000000.0},
 "rules": [{"rule_id": "U01", "from": ["g", "gram", "克"], "to": "g", "factor": 1.0, "prefixable": true}, {"rule_id": "U02", "from": ["kg", "千克"], "to": "kg", "factor": 1.0, "prefixable": true}, {"rule_id": "U03", "from": ["mol", "摩尔"], "to": "mol", "factor": 1.0, "prefixable": true}, {"rule_id": "U04", "from": ["s", "sec", "秒"], "to": "s", "factor": 1.0, "prefixable": true}, {"rule_id": "U05", "from": ["min", "minute", "分钟"], "to": "s", "factor": 60.0}, {"rule_id": "U06", "from": ["h", "hr", "hour", "小时"], "to": "s", "factor": 3600.0}, {"rule_id": "U07", "from": ["m", "meter", "米"], "to": "m", "factor": 1.0, "prefixable": true}, {"rule_id": "U08", "from": ["L", "l", "升"], "to": "L", "factor": 1.0, "prefixable": true}, {"rule_id": "U09", "from": ["Pa", "pa", "帕"], "to": "Pa", "factor": 1.0, "prefixable": true}, {"rule_id": "U10", "from": ["bar", "巴"], "to": "kPa", "factor": 100.0}, {"rule_id": "U11", "from": ["atm", "大气压"], "to": "kPa", "factor": 101.325}, {"rule_id": "U12", "from": ["psi"], "to": "kPa", "factor": 6.894757}, {"rule_id": "U13", "from": ["°C", "C", "℃"], "to": "°C", "factor": 1.0}, {"rule_id": "U14", "from": ["°F", "F", "℉"], "to": "°C", "factor": 0.5555555555555556, "offset": -17.77777777777778}, {"rule_id": "U15", "from": ["K", "kelvin", "开尔文"], "to": "K", "factor": 1.0}, {"rule_id": "U16", "from": ["W", "w", "瓦"], "to": "W", "factor": 1.0, "prefixable": true}, {"rule_id": "U17", "from": ["J", "j", "焦耳"], "to": "J", "factor": 1.0, "prefixable": true}, {"rule_id": "U18", "from": ["V", "v", "伏"], "to": "V", "factor": 1.0, "prefixable": true}, {"rule_id": "U19", "from": ["A", "a", "amp", "安"], "to": "A", "factor": 1.0, "prefixable": true}, {"rule_id": "U20", "from": ["eV", "ev", "电子伏"], "to": "eV", "factor": 1.0}, {"rule_id": "U21", "from": ["%", "percent", "百分比"], "to": "%", "factor": 1.0}, {"rule_id": "U22", "from": ["ppm"], "to": "mg kg-1", "factor": 1.0}, {"rule_id": "U24", "from": ["mg kg-1", "mg/kg"], "to": "mg kg-1", "factor": 1.0}, {"rule_id": "U25", "from": ["mg L-1", "mg/l", "mg/L"], "to": "mg L-1", "factor": 1.0}, {"rule_id": "U26", "from": ["mol L-1", "mol/l", "mol/L"], "to": "mol L-1", "factor": 1.0}, {"rule_id": "U27", "from": ["mW cm-2", "mW/cm2"], "to": "W m-2", "factor": 10.0}, {"rule_id": "U28", "from": ["µmol m-2 s-1"], "to": "µmol m-2 s-1", "factor": 1.0}],
 "ranges": {"temperature": {"lo": -273.15, "hi": 4000}, "reaction temperature": {"lo": -273.15, "hi": 4000}, "degradation efficiency": {"lo": 0, "hi": 100}, "efficiency": {"lo": 0, "hi": 100}, "band gap": {"lo": 0, "hi": 20}}
}
